# Local development only. Copy to .env; do not commit real credentials.
# Compose reads .env automatically; Go requires exported environment variables.
HTTP_ADDR=127.0.0.1:8080
REDIS_ADDR=127.0.0.1:16379
# Maximum pending + processing + retrying deliveries. Same value on all APIs.
MAX_PENDING_DELIVERIES=10000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=hookrelay
MYSQL_USER=hookrelay
MYSQL_PASSWORD=hookrelay_local_only
MYSQL_ROOT_PASSWORD=root_local_only
# Required by cmd/api. Generate your own local key.
API_KEY=
# Only this exact URL may be registered (local development receiver).
ALLOWED_ENDPOINT_URL=http://127.0.0.1:9090/webhook