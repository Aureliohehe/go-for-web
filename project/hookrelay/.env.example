# Local development only. Copy to .env; do not commit real credentials.
# Compose reads .env automatically; Go requires exported environment variables.
HTTP_ADDR=127.0.0.1:8080
REDIS_ADDR=127.0.0.1:16379
# Maximum pending + processing + retrying deliveries. Same value on all APIs.
MAX_PENDING_DELIVERIES=10000
# Single Worker process: total execution slots and per-endpoint-ID quota.
# Keep endpoint < total to leave room for other endpoints. Not a global quota.
WORKER_CONCURRENCY=4
ENDPOINT_CONCURRENCY=1
# Worker HTTP retry backoff and capped Retry-After (Go duration syntax).
RETRY_BASE_DELAY=5s
RETRY_MAX_DELAY=1m
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=hookrelay
MYSQL_USER=hookrelay
MYSQL_PASSWORD=hookrelay_local_only
MYSQL_ROOT_PASSWORD=root_local_only
# Required by cmd/api. Generate your own local key.
API_KEY=
# Only this exact URL may be registered (local development receiver).
ALLOWED_ENDPOINT_URL=http://127.0.0.1:9090/webhook
# Required by cmd/receiver: the signing_secret returned once by endpoint creation.
# This is NOT API_KEY. Keep the real value private; no unsigned receiver mode.
RECEIVER_SIGNING_SECRET=
# Independent recipient database; provision it and apply migrations/receiver first.
# Receiver does not inherit platform MYSQL_* credentials.
RECEIVER_MYSQL_HOST=127.0.0.1
RECEIVER_MYSQL_PORT=13306
RECEIVER_MYSQL_DATABASE=hookrelay_receiver
RECEIVER_MYSQL_USER=hookrelay_receiver
RECEIVER_MYSQL_PASSWORD=
